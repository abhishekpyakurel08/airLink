{
  "manifest_version": 3,
  "name": "airLink Remote Control",
  "version": "1.0.0",
  "description": "Real-time remote control Chrome extension paired with Expo React Native Mobile App via WebSocket",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background/background.js"
  },
  "action": {
    "default_popup": "public/popup.html",
    "default_title": "airLink Pairing"
  }
}
