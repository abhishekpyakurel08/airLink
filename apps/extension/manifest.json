{
  "manifest_version": 3,
  "name": "AirLink Remote Control",
  "version": "2.0.0",
  "description": "AirLink Chrome Extension with real-time WebSocket remote control, mouse touchpad, tab manager & custom shortcuts",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "public/popup.html",
    "default_title": "AirLink Pairing"
  }
}
